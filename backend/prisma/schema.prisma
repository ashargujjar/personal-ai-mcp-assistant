generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id                   String         @id @default(cuid())
  name                 String
  email                String         @unique
  password             String?
  googleId             String?        @unique
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  gmailAccessToken     String?
  gmailRefreshToken    String?
  gmailTokenExpiry     DateTime?
  calendarAccessToken  String?
  calendarRefreshToken String?
  calendarTokenExpiry  DateTime?
  memories             Memory[]
  tasks                Task[]
  documents            Document[]
  resumeSearches       ResumeSearch[]
  githubReviews        GitHubReview[]

  @@map("users")
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  title       String
  description String?   @db.Text
  priority    String    @default("medium")
  deadline    DateTime?
  project     String?
  source      String    @default("manual")
  status      String    @default("todo")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@map("tasks")
}

enum ResumeSearchStatus {
  QUEUED
  SEARCHING_GMAIL
  PROCESSING
  COMPLETED
  FAILED
}

enum ResumeApplicantStatus {
  DISCOVERED
  DOWNLOADING
  UPLOADING
  SAVED
  FAILED
}

enum ResumeAtsScanStatus {
  NOT_STARTED
  QUEUED
  SCANNING
  COMPLETED
  FAILED
}

model ResumeSearch {
  id           String             @id @default(cuid())
  userId       String             @map("user_id")
  jobTitle     String             @map("job_title")
  description  String?            @db.Text
  dateFrom     DateTime           @map("date_from")
  dateTo       DateTime           @map("date_to")
  status       ResumeSearchStatus @default(QUEUED)
  total        Int                @default(0)
  processed    Int                @default(0)
  succeeded    Int                @default(0)
  failed       Int                @default(0)
  errorMessage String?            @map("error_message") @db.Text
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  startedAt    DateTime?          @map("started_at")
  finishedAt   DateTime?          @map("finished_at")
  atsStatus    ResumeAtsScanStatus @default(NOT_STARTED) @map("ats_status")
  atsTotal     Int                @default(0) @map("ats_total")
  atsProcessed Int                @default(0) @map("ats_processed")
  atsSucceeded Int                @default(0) @map("ats_succeeded")
  atsFailed    Int                @default(0) @map("ats_failed")
  atsErrorMessage String?         @map("ats_error_message") @db.Text
  atsStartedAt DateTime?          @map("ats_started_at")
  atsFinishedAt DateTime?         @map("ats_finished_at")

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicants ResumeApplicant[]
  jobDetails ResumeJobDetails?
  atsResults ResumeAtsResult[]

  @@index([userId, createdAt])
  @@index([userId, status])
  @@map("resume_searches")
}

model ResumeJobDetails {
  id                String   @id @default(cuid())
  jobId             String   @unique @map("job_id")
  title             String?
  requiredSkills    Json?    @map("required_skills")
  preferredSkills   Json?    @map("preferred_skills")
  minimumExperience Int?     @map("minimum_experience")
  maximumExperience Int?     @map("maximum_experience")
  education         String?  @db.Text
  responsibilities  Json?
  location          String?
  employmentType    String?  @map("employment_type")
  seniority         String?
  certifications    Json?
  languages         Json?
  notes             String?  @db.Text
  rawExtractedData  Json?    @map("raw_extracted_data")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  job ResumeSearch @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("resume_job_details")
}

model ResumeApplicant {
  id                 String                @id @default(cuid())
  searchId           String                @map("search_id")
  userId             String                @map("user_id")
  gmailMessageId     String                @map("gmail_message_id")
  gmailAttachmentId  String                @map("gmail_attachment_id")
  gmailThreadId      String                @map("gmail_thread_id")
  emailFrom          String                @map("email_from")
  emailTo            String                @map("email_to")
  emailBody          String                @map("email_body") @db.Text
  emailSnippet       String                @map("email_snippet") @db.Text
  gmailLabelIds      Json?                 @map("gmail_label_ids")
  candidateName      String?               @map("candidate_name")
  candidateEmail     String?               @map("candidate_email")
  candidatePhone     String?               @map("candidate_phone")
  candidateAddress   String?               @map("candidate_address") @db.Text
  pdfTextExtraction  Json?                 @map("pdf_text_extraction")
  pdfTextExtractedAt DateTime?             @map("pdf_text_extracted_at")
  emailSubject       String                @map("email_subject")
  receivedAt         DateTime              @map("received_at")
  originalFilename   String                @map("original_filename")
  mimeType           String                @map("mime_type")
  fileSize           Int?                  @map("file_size")
  cloudinaryPublicId String?               @map("cloudinary_public_id")
  status             ResumeApplicantStatus @default(DISCOVERED)
  errorMessage       String?               @map("error_message") @db.Text
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  search ResumeSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)
  atsResult ResumeAtsResult?

  @@unique([searchId, gmailMessageId, gmailAttachmentId])
  @@index([userId, createdAt])
  @@index([searchId, status])
  @@map("resume_applicants")
}

model ResumeAtsResult {
  id                String   @id @default(cuid())
  searchId          String   @map("search_id")
  applicantId       String   @unique @map("applicant_id")
  userId            String   @map("user_id")
  matchScore        Int      @map("match_score")
  skills            Json
  matchedSkills     Json     @map("matched_skills")
  experienceYears   Int?     @map("experience_years")
  experienceSummary String?  @map("experience_summary") @db.Text
  education         String?  @db.Text
  strengths         Json
  gaps              Json
  rawModelOutput    Json?    @map("raw_model_output")
  scanVersion       String   @default("resume-ats-v1") @map("scan_version")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  search    ResumeSearch    @relation(fields: [searchId], references: [id], onDelete: Cascade)
  applicant ResumeApplicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([searchId, matchScore])
  @@index([userId, createdAt])
  @@map("resume_ats_results")
}

enum GitHubReviewStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model GitHubReview {
  id             String            @id @default(cuid())
  userId         String            @map("user_id")
  repositoryId   Int               @map("repository_id")
  repositoryUrl  String            @map("repository_url")
  owner          String
  repository     String
  status         GitHubReviewStatus @default(QUEUED)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  manifest RepositoryManifest?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("github_reviews")
}

model RepositoryManifest {
  id                    String   @id @default(cuid())
  reviewId              String   @unique @map("review_id")
  repositoryId          Int      @map("repository_id")
  repositoryUrl         String   @map("repository_url")
  owner                 String
  repository            String
  commitSha             String   @map("commit_sha")
  fileCount             Int      @default(0) @map("file_count")
  sourceFileCount       Int      @default(0) @map("source_file_count")
  configFileCount       Int      @default(0) @map("config_file_count")
  documentationFileCount Int     @default(0) @map("documentation_file_count")
  testFileCount         Int      @default(0) @map("test_file_count")
  manifestFileCount     Int      @default(0) @map("manifest_file_count")
  unknownFileCount      Int      @default(0) @map("unknown_file_count")
  files                 Json
  createdAt             DateTime @default(now()) @map("created_at")

  review GitHubReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([repositoryId, commitSha])
  @@map("repository_manifests")
}

model Memory {
  id        String                       @id @default(cuid())
  userId    String
  user      User                         @relation(fields: [userId], references: [id])
  type      String
  key       String?
  content   String                       @db.Text
  // text-embedding-3-small
  // Dimension must match your embedding model's output size (1536 = OpenAI text-embedding-3-small). Change if you use a different model.
  embedding Unsupported("vector(1536)")?
  metadata  Json?
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt

  @@unique([userId, key], name: "userId_key_unique")
  @@index([userId])
  @@map("memories")
}

enum ChunkSetStatus {
  BUILDING
  READY
}

model ChunkSet {
  id                String         @id @default(cuid())
  documentVersionId String         @map("document_version_id")
  parserVersion     String         @map("parser_version")
  chunkingVersion   String         @map("chunking_version")
  status            ChunkSetStatus @default(BUILDING)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  documentVersion DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  chunks          DocumentChunk[]

  @@unique([documentVersionId, parserVersion, chunkingVersion])
  @@map("chunk_sets")
}

model DocumentChunk {
  id          String                       @id @default(cuid())
  chunkSetId  String                       @map("chunk_set_id")
  chunkIndex  Int                          @map("chunk_index")
  text        String                       @db.Text
  tokenCount  Int                          @map("token_count")
  pageStart   Int                          @map("page_start")
  pageEnd     Int                          @map("page_end")
  sourceUnits Json                         @map("source_units")
  embedding   Unsupported("vector(1536)")?
  chunkSet    ChunkSet                     @relation(fields: [chunkSetId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([chunkSetId, chunkIndex])
  @@map("document_chunks")
}

model DocumentVersion {
  id            String @id @default(cuid())
  documentId    String @map("document_id")
  versionNumber Int    @map("version_number")

  storageKey       String @unique @map("storage_key")
  filename         String
  originalFilename String @map("original_filename")
  mimeType         String @map("mime_type")
  fileSize         Int    @map("file_size")
  fileHash         String @map("file_hash")

  createdAt DateTime @default(now()) @map("created_at")

  document      Document       @relation(fields: [documentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ingestionJobs IngestionJob[]
  chunkSets     ChunkSet[]

  @@unique([documentId, versionNumber])
  @@index([fileHash])
  @@map("document_versions")
}

enum IngestionStatus {
  QUEUED
  RUNNING
  RETRY_WAIT
  SUCCEEDED
  FAILED
}

enum IngestionStage {
  SOURCE_ACCESS
  PARSING
  METADATA
  CHUNKING
  EMBEDDING
}

model IngestionJob {
  id                String          @id @default(cuid())
  documentVersionId String          @map("document_version_id")
  status            IngestionStatus @default(QUEUED)
  stage             IngestionStage?
  // This first pipeline only verifies source access; parsing comes later.
  pipelineVersion   String          @map("pipeline_version")
  parserVersion     String?         @map("parser_version")
  chunkingVersion   String?         @map("chunking_version")
  embeddingModel    String?         @map("embedding_model")
  attemptCount      Int             @default(0) @map("attempt_count")
  maxAttempts       Int             @default(3) @map("max_attempts")
  claimToken        String?         @map("claim_token")
  leaseExpiresAt    DateTime?       @map("lease_expires_at")
  nextAttemptAt     DateTime        @default(now()) @map("next_attempt_at")
  lastErrorCode     String?         @map("last_error_code")
  lastErrorMessage  String?         @map("last_error_message")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  startedAt         DateTime?       @map("started_at")
  finishedAt        DateTime?       @map("finished_at")

  documentVersion DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  outboxEvents    OutboxEvent[]

  @@index([documentVersionId, createdAt])
  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
  @@map("ingestion_jobs")
}

model OutboxEvent {
  id                   String    @id @default(cuid())
  ingestionJobId       String    @map("ingestion_job_id")
  eventType            String    @default("ingestion.requested") @map("event_type")
  schemaVersion        Int       @default(1) @map("schema_version")
  createdAt            DateTime  @default(now()) @map("created_at")
  availableAt          DateTime  @default(now()) @map("available_at")
  dispatchedAt         DateTime? @map("dispatched_at")
  dispatchAttemptCount Int       @default(0) @map("dispatch_attempt_count")
  claimToken           String?   @map("claim_token")
  leaseExpiresAt       DateTime? @map("lease_expires_at")
  lastErrorMessage     String?   @map("last_error_message")

  ingestionJob IngestionJob @relation(fields: [ingestionJobId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([ingestionJobId, eventType])
  @@index([dispatchedAt, availableAt])
  @@map("outbox_events")
}

model Document {
  // document
  id               String            @id @default(cuid())
  tenantId         String            @map("tenant_id")
  userId           String            @map("user_id")
  user             User              @relation(fields: [userId], references: [id])
  title            String?
  shortDescription String?           @map("short_description") @db.Text
  keywords         Json?
  author           String?
  language         String?
  status           String            @default("uploaded")
  embeddingModel   String?           @map("embedding_model")
  parserVersion    String?           @map("parser_version")
  chunkingVersion  String?           @map("chunking_version")
  pageCount        Int?              @map("page_count")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  versions         DocumentVersion[]

  @@index([tenantId, userId, createdAt])
  @@map("documents")
}
